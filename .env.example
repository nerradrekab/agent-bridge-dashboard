# PUBLIC build-time configuration only.
# Every VITE_* variable is inlined into the browser bundle and is readable by
# anyone who loads the site. Never put API keys, service-account JSON, OAuth
# secrets, spreadsheet IDs or Sheet URLs here.

# "mock" (default, fictional demo data) or "http" (secure proxy API, Phase 2)
VITE_DATA_SOURCE=mock

# Base URL of the authenticated read-only proxy, e.g. https://bridge-api.example.com
# Only used when VITE_DATA_SOURCE=http. Must be HTTPS and serve CORS for the Pages origin.
VITE_API_BASE_URL=

# Sub-path for GitHub project Pages, e.g. /agent-bridge-dashboard/
# The Pages workflow sets this automatically. Use / for a custom domain.
VITE_BASE_PATH=/

# Data older than this (minutes) is flagged as stale in the UI.
VITE_STALE_AFTER_MINUTES=180

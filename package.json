{
  "name": "agent-bridge-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Read-only control centre for the ChatGPT <-> Instinct Agent Bridge",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "scan:dist": "node scripts/check-no-secrets.mjs --dir dist",
    "scan:staged": "node scripts/check-no-secrets.mjs --staged",
    "build:private": "tsc -b && vite build --outDir dist-private --emptyOutDir --mode private",
    "worker:deploy": "npm run build:private && wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
